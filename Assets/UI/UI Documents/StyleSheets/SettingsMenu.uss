:root {
    --font-main: url("project://database/Assets/Font/Kabel_Regular.ttf?fileID=12800000&guid=7e6037f3fb6824a4fa9d6f197d8131c6&type=3#Kabel_Regular");
    --color-white: rgb(255, 255, 255);
    --color-white-dim: rgba(255, 255, 255, 0.55);
    --color-white-faint: rgba(255, 255, 255, 0.15);
    --color-accent: rgb(255, 220, 120);
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.panel {
    width: 520px;
    min-height: 480px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    -unity-overflow-clip-box: content-box;
    overflow: hidden;
    align-items: stretch;
    justify-content: flex-start;
}

.panel-bg {
    scale: 1 1;
    width: 100%;
    height: 100%;
}

.content {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    align-items: stretch;
    padding: 40px 48px 36px 48px;
}

.title {
    -unity-font-definition: var(--font-main);
    font-size: 42px;
    color: var(--color-white);
    -unity-text-align: upper-center;
    letter-spacing: 3px;
    margin-bottom: 6px;
}

.divider {
    height: 1px;
    background-color: var(--color-white-faint);
    margin-top: 4px;
    margin-bottom: 32px;
}



.spacer {
    flex-grow: 1;
    min-height: 20px;
}

.return-btn {
    align-self: center;
    margin-bottom: 0;
}
