<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/UI%20Documents/StyleSheets/Button.uss?fileID=7433441132597879392&amp;guid=41c8e0a22b2d7914bb2f653b5be56a81&amp;type=3#Button"/>
    <ui:VisualElement name="Backround" style="flex-grow: 1; background-color: rgba(255, 255, 255, 0); align-items: center; align-content: center; justify-content: center; background-image: url(&quot;project://database/Assets/Sprites/UI/StartScene.png?fileID=2800000&amp;guid=125a620dbc9655f4fa283c6fb250ea15&amp;type=3#StartScene&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); scale: -1 1;">
        <ui:Image style="align-content: stretch; align-self: stretch; position: absolute; top: 0; bottom: 0; left: 0; right: 0; background-color: rgba(106, 106, 106, 0.165); display: flex;"/>
        <ui:GroupBox name="GroupBox" style="justify-content: center; align-content: center; align-self: flex-start; align-items: center; translate: 1200px 0; scale: -1 1;">
            <ui:Image source="project://database/Assets/Sprites/UI/Game_Logo_Update.png?fileID=2800000&amp;guid=4eb03f3c53451d447bc77f4f7097c8d0&amp;type=3#Game_Logo_Update" tint-color="rgb(255, 255, 255)" style="text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255);"/>
            <ui:Button text="Start" name="startButton" class="Button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            <ui:Button text="Settings" name="settingsButton" class="Button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            <ui:Button text="Credits" name="creditsButton" class="Button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            <ui:Button text="Quit" name="quitButton" class="Button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
